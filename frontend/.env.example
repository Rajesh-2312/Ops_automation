# frontend/.env.example — NAMES ONLY. Copy to frontend/.env.local and fill in.
#
# Vite exposes ONLY variables prefixed with VITE_ to the browser bundle. That
# prefix rule is the guardrail that keeps SUPABASE_SERVICE_ROLE_KEY (repo-root
# .env, no prefix) out of anything that ships to a client. Never add a service
# role key here — it carries BYPASSRLS and would hand every persona wall to the
# browser (CLAUDE.md R5).

# Supabase project URL and the ANON key. The anon key is public by design; RLS
# is what protects the data behind it.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# FastAPI base URL, e.g. http://localhost:8000 in dev. Used only for the work
# RLS cannot express — currently checklist and document-register generation
# (POST /programs/{id}/tasks:generate, POST /programs/{id}/documents:generate).
# Leave blank to use same-origin relative paths behind a reverse proxy.
VITE_API_BASE_URL=
