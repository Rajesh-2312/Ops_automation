# byteXL Ops Intelligence Platform — environment template
#
# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# This file carries variable NAMES ONLY. No values, no examples that look
# like real keys.

# --- Supabase -----------------------------------------------------------------
# From the Supabase dashboard: Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Backend only. Carries BYPASSRLS — every endpoint using it MUST re-check
# role and ownership in code (CLAUDE.md R5, and see app/core/security.py).
# Never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# The HS256 secret Supabase signs user access tokens with. The API needs it to
# verify any caller; without it every authenticated endpoint returns 500 by
# design (app/core/security.py fails closed rather than trusting unverified
# tokens). Not needed by the frontend, which talks to Supabase directly.
# Dashboard: Project Settings -> API -> JWT Settings -> JWT Secret.
SUPABASE_JWT_SECRET=

# Direct Postgres connection, used by Alembic-free SQL migrations and the RLS
# test runner. Use the SESSION pooler (port 5432), NOT the transaction pooler
# (6543) — `SET ROLE` does not survive the transaction pooler, which silently
# breaks every persona test.
DATABASE_URL=

# --- LLM (OpenRouter is the sole gateway — CLAUDE.md §2) ----------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Task-based model routing. Model ids live in env so routing can change without
# a code deploy. VOLUME handles drafting/chase/summaries; FRONTIER handles
# document extraction and governance reports.
#
# Both are optional: Phase 1 has no AI in it (CLAUDE.md §13), so the program
# tracker boots without them. `LLMClient` refuses to construct if they are
# missing, naming each one — loud at the point of use, not at app import.
#
# Working values, verified against the live gateway:
#   OPENROUTER_MODEL_VOLUME=anthropic/claude-haiku-4.5     $1.00/$5.00 per M
#   OPENROUTER_MODEL_FRONTIER=anthropic/claude-sonnet-5    $2.00/$10.00 per M
#
# The 2x gap is the point of having two tiers. Chase messages and summaries are
# high-volume and low-stakes; MoU/PO extraction and governance reports are the
# opposite, and §8 caps both at Draft anyway, so a human reads every word.
# Note claude-sonnet-5 is cheaper than claude-sonnet-4.6 ($3/$15) and newer —
# check live pricing before assuming a higher version number costs more.
OPENROUTER_MODEL_VOLUME=
OPENROUTER_MODEL_FRONTIER=

# Optional: sent as OpenRouter attribution headers.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=byteXL Ops Intelligence Platform

# --- App ----------------------------------------------------------------------
APP_ENV=dev

# Keep this at INFO or above in any shared environment. `app/core/llm.py` logs
# token counts and latency at INFO, but the full prompt and completion at DEBUG —
# and prompts carry trainer PII (PAN, bank details, payout figures). DEBUG in
# production writes that to your log store.
LOG_LEVEL=INFO

# --- AgentMail -----------------------------------------------------------
# Outbound mail for test/ops reporting ONLY. Never bind this to an agent
# toolset (CLAUDE.md R3/R4). Names only in this file — real key lives in .env.
AGENTMAIL_API_KEY=
# Comma-separated hard allow-list. The sender refuses anything not listed.
AGENTMAIL_ALLOWED_RECIPIENTS=
# Embeddings for the RAG corpora. Must be a 1536-dimension model —
# rag_embeddings.embedding is vector(1536) (migration 1600).
OPENROUTER_EMBEDDING_MODEL=

# --- Browser origins allowed to call this API --------------------------------
# Comma-separated EXACT origins. Empty installs no CORS middleware, which is
# correct only when the console and this API share an origin behind a reverse
# proxy. They do not in dev (Vite on :5173, API on :8000) and they do not on a
# static host, so leaving this empty makes every browser call fail before it is
# sent — reported by the console as "Could not reach the API", with nothing in
# this service's log because nothing arrived.
#   CORS_ALLOWED_ORIGINS=http://localhost:5173,https://rajesh-2312.github.io
# `*` is refused at startup: every call here carries a bearer token.
CORS_ALLOWED_ORIGINS=
